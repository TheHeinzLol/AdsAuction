
// 1. Discover containers from this Compose project only
discovery.docker "containers" {
    host = "unix:///var/run/docker.sock"
    
    // Filter by the Compose project label
    filter {
        name   = "label"
        values = ["com.docker.compose.project=lgtm-test"]
    }
}

// 2. Extract useful labels from Docker metadata
discovery.relabel "container_labels" {
    targets = discovery.docker.containers.targets

    // Compose service name: fastapi, loki, alloy, grafana
    rule {
        source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
        target_label  = "service_name"
    }

    // Actual Docker container name: lgtm_fastapi, lgtm_alloy, etc.
    rule {
        source_labels = ["__meta_docker_container_name"]
        regex         = "/(.*)"
        target_label  = "container"
    }
}

loki.source.docker "logs" {
    host       = "unix:///var/run/docker.sock"
    targets    = discovery.docker.containers.targets
    relabel_rules = discovery.relabel.container_labels.rules
    forward_to = [loki.write.default.receiver]
}

loki.write "default" {
    endpoint {
        url = "http://loki:3100/loki/api/v1/push"
    }
}

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.batch.default.input]
    metrics = [otelcol.processor.batch.metrics.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.processor.batch "metrics" {
  output {
    metrics = [otelcol.exporter.prometheus.default.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}

otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.default.receiver]
}
