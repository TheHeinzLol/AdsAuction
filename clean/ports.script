#!/usr/bin/env bash
#
# This script finds vacant host ports for local services
# and writes them to a .env file for Docker Compose to use.
#
set -euo pipefail

# Default ports to try first
METRICS_PORT=8041 # arbitrary chosen
PREFERRED_SSP=8001
PREFERRED_ADX=8002
PREFERRED_DSP=8003
PREFERRED_PROMETHEUS=9091
PREFERRED_LOKI=3101
PREFERRED_TEMPO=3201
PREFERRED_ALLOY=12346
PREFERRED_GRAFANA=3001
PREFERRED_PGADMIN=5051
PREFERRED_DB_SSP=5433
PREFERRED_DB_ADX=5434
PREFERRED_DB_DSP=5435
PREFERRED_REDIS_SSP=6380
PREFERRED_REDIS_ADX=6381
PREFERRED_REDIS_DSP=6382

# Where to write the result
ENV_FILE="${ENV_FILE:-.env}"

# ---------- Helper: find first vacant port starting at $1 ----------
find_port() {
    local port=$1
    local max=$((port + 200))   # Search range
    while (( port <= max )); do
        if ! is_port_in_use "$port"; then
            echo "$port"
            return 0
        fi
        ((port++))
    done
    echo "ERROR: No vacant port found near $1" >&2
    return 1
}

# ---------- Helper: check if port is in use ----------
is_port_in_use() {
    local port=$1
    # ss is on most modern Linux systems; fall back to netstat if missing
    if command -v ss >/dev/null 2>&1; then
        ss -tuln | grep -q ":${port} " && return 0 || return 1
    elif command -v netstat >/dev/null 2>&1; then
        netstat -tuln | grep -q ":${port} " && return 0 || return 1
    else
        # Last resort: try to bind with Python
        python3 - "$port" <<'PY'
import socket, sys
port = int(sys.argv[1])
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
try:
    s.bind(("127.0.0.1", port))
    s.close()
    sys.exit(1)   # Port is FREE -> exit 1 (not in use)
except OSError:
    sys.exit(0)   # Port is IN USE -> exit 0
PY
    fi
}

# ---------- Find ports ----------
SSP_PORT=$(find_port "$PREFERRED_SSP")
ADX_PORT=$(find_port "$PREFERRED_ADX")
DSP_PORT=$(find_port "$PREFERRED_DSP")
PROMETHEUS_PORT=$(find_port "$PREFERRED_PROMETHEUS")
LOKI_PORT=$(find_port "$PREFERRED_LOKI")
TEMPO_PORT=$(find_port "$PREFERRED_TEMPO")
ALLOY_PORT=$(find_port "$PREFERRED_ALLOY")
GRAFANA_PORT=$(find_port "$PREFERRED_GRAFANA")
PGADMIN_PORT=$(find_port "$PREFERRED_PGADMIN")
DB_SSP_PORT=$(find_port "$PREFERRED_DB_SSP")
DB_ADX_PORT=$(find_port "$PREFERRED_DB_ADX")
DB_DSP_PORT=$(find_port "$PREFERRED_DB_DSP")
REDIS_SSP_PORT=$(find_port "$PREFERRED_REDIS_SSP")
REDIS_ADX_PORT=$(find_port "$PREFERRED_REDIS_ADX")
REDIS_DSP_PORT=$(find_port "$PREFERRED_REDIS_DSP")

# ---------- Report ----------
echo "Found vacant ports:"
echo "  SSP_PORT        = $SSP_PORT"
echo "  ADX_PORT        = $ADX_PORT"
echo "  DSP_PORT        = $DSP_PORT"
echo "  METRICS_PORT    = $METRICS_PORT"
echo "  PROMETHEUS_PORT = $PROMETHEUS_PORT"
echo "  LOKI_PORT       = $LOKI_PORT"
echo "  TEMPO_PORT      = $TEMPO_PORT"
echo "  ALLOY_PORT      = $ALLOY_PORT"
echo "  GRAFANA_PORT    = $GRAFANA_PORT"
echo "  PGADMIN_PORT    = $PGADMIN_PORT"
echo "  DB_SSP_PORT     = $DB_SSP_PORT"
echo "  DB_ADX_PORT     = $DB_ADX_PORT"
echo "  DB_DSP_PORT     = $DB_DSP_PORT"
echo "  REDIS_SSP_PORT     = $REDIS_SSP_PORT"
echo "  REDIS_ADX_PORT     = $REDIS_ADX_PORT"
echo "  REDIS_DSP_PORT     = $REDIS_DSP_PORT"

# ---------- Write .env ----------
cat > "$ENV_FILE" <<EOF
# Auto-generated by scripts/find-ports.sh
# Do not edit by hand unless you know what you're doing.

SSP_PORT=$SSP_PORT
ADX_PORT=$ADX_PORT
DSP_PORT=$DSP_PORT
METRICS_PORT=$METRICS_PORT
PROMETHEUS_PORT=$PROMETHEUS_PORT
LOKI_PORT=$LOKI_PORT
TEMPO_PORT=$TEMPO_PORT
ALLOY_PORT=$ALLOY_PORT
GRAFANA_PORT=$GRAFANA_PORT
PGADMIN_PORT=$PGADMIN_PORT
DB_SSP_PORT=$DB_SSP_PORT
DB_ADX_PORT=$DB_ADX_PORT
DB_DSP_PORT=$DB_DSP_PORT
REDIS_SSP_PORT=$REDIS_SSP_PORT
REDIS_ADX_PORT=$REDIS_ADX_PORT
REDIS_DSP_PORT=$REDIS_DSP_PORT
EOF

echo
echo "Wrote $ENV_FILE"
